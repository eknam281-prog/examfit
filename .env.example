# 서버 전용 환경변수 (브라우저에 노출 금지). 실제 값은 .env.local 에만 저장.
FACTCHAT_API_KEY=
FACTCHAT_API_BASE_URL=
FACTCHAT_MODEL=
FACTCHAT_API_FORMAT=   # 현재 지원: openai-chat (POST {BASE_URL}/chat/completions, Bearer 인증). 규격 확인 후에만 설정
FACTCHAT_REALTIME_MODEL=   # 음성(구술시험) 전용 모델. 텍스트 생성 설정과 별개. GET /v1/gateway/models/?type=realtime 로 확인된 ID만
FACTCHAT_VISION_MODEL=   # 스캔 PDF 비전 OCR 모델(이미지 입력 지원 확인된 ID)

# AI 기능(문제 생성·서술형 피드백·스캔 OCR·AI 구술시험)은 이 값이 true일 때만 서버가 FactChat을 호출합니다. 기본값(미설정)은 꺼짐.
# 공개 배포에서는 AI 기능을 시연하는 기간에만 true로 설정하세요(호출마다 크레딧이 사용됩니다).
EXAMFIT_AI_ENABLED=

# AI 구술시험(실시간 음성)은 세션 길이를 서버가 제한할 수 없어 별도 스위치입니다. true일 때만 음성 세션을 발급합니다(기본 꺼짐).
EXAMFIT_ORAL_ENABLED=
